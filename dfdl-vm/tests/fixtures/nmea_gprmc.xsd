<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:dfdl="http://www.ogf.org/dfdl/dfdl-1.0/">
  <dfdl:format representation="text" encoding="UTF-8" lengthKind="delimited"/>

  <xs:element name="GPRMC" dfdl:terminator="%CR;%LF;">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="body" dfdl:initiator="$GPRMC," dfdl:terminator="*" dfdl:lengthKind="implicit">
          <xs:complexType>
            <xs:sequence dfdl:separator="," dfdl:separatorPosition="infix">
              <xs:element name="utcTime" type="xs:string"/>
              <xs:element name="status" type="xs:string" dfdl:lengthKind="fixed" dfdl:length="1"/>
              <xs:element name="latitude" type="xs:string"/>
              <xs:element name="latHemisphere" type="xs:string" dfdl:lengthKind="fixed" dfdl:length="1"/>
              <xs:element name="longitude" type="xs:string"/>
              <xs:element name="lonHemisphere" type="xs:string" dfdl:lengthKind="fixed" dfdl:length="1"/>
              <xs:element name="speedKnots" type="xs:string"/>
              <xs:element name="trackTrue" type="xs:string"/>
              <xs:element name="date" type="xs:string"/>
              <xs:element name="magneticVariation" type="xs:string"/>
              <xs:element name="magVarHemisphere" type="xs:string" dfdl:lengthKind="fixed" dfdl:length="1"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="checksum" type="xs:string" dfdl:lengthKind="fixed" dfdl:length="2"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
